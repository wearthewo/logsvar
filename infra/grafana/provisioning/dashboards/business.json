          "metricColumn": "value",
          "rawQuery": true,
          "rawSql": "SELECT \n  CASE \n    WHEN DATE_FORMAT(detected_at, '%H') BETWEEN 0 AND 5 THEN '00-05'\n    WHEN DATE_FORMAT(detected_at, '%H') BETWEEN 6 AND 11 THEN '06-11'\n    WHEN DATE_FORMAT(detected_at, '%H') BETWEEN 12 AND 17 THEN '12-17'\n    ELSE '18-23'\n  END as time_period,\n  COUNT(*) as value\nFROM anomalies \nWHERE detected_at > NOW() - INTERVAL 24 HOUR \nGROUP BY 1\nORDER BY 1",
          "refId": "A"
        }
      ],
      "title": "Anomalies by Time Period (24h)",
